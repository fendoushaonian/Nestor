{
  "expo": {
    "name": "{{name}}",
    "slug": "{{name}}",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nestor.{{name}}"
    },
    "android": {
      "package": "com.nestor.{{name}}"
    },
    "web": {
      "bundler": "metro"
    }
  }
}

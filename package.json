{
  "name": "nestor",
  "version": "0.1.0",
  "private": true,
  "description": "Nestor - 企业级 APP 快速开发脚手架 (NestJS)",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @nestor/core build && pnpm --filter @nestor/api start:dev",
    "start": "pnpm --filter @nestor/api start:prod",
    "lint": "eslint \"{apps,packages}/**/*.ts\"",
    "format": "prettier --write \"{apps,packages}/**/*.ts\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "migration:generate": "pnpm --filter @nestor/api migration:generate",
    "migration:run": "pnpm --filter @nestor/api migration:run",
    "migration:revert": "pnpm --filter @nestor/api migration:revert"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}

# ============ 应用 ============
NODE_ENV=development
APP_PORT=3000
APP_PREFIX=api
# Swagger 文档开关
SWAGGER_ENABLED=true
# 允许的跨域来源 (逗号分隔), 留空则放行所有来源 (仅适合开发期)
# 例: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ============ 数据库（多数据库可切换） ============
# 支持: sqlite | better-sqlite3 | mysql | mariadb | postgres | cockroachdb | mssql | oracle
# 切换后只需重启, 业务代码不用改。各库需安装对应驱动 (按需, 见下方):
#   mysql / mariadb  -> pnpm --filter @nestor/api add mysql2
#   postgres / cockroachdb -> pnpm --filter @nestor/api add pg
#   mssql (SQL Server) -> pnpm --filter @nestor/api add mssql
#   oracle           -> pnpm --filter @nestor/api add oracledb
#   better-sqlite3   -> pnpm --filter @nestor/api add better-sqlite3
#   sqlite           -> 已内置, 无需安装
DB_TYPE=sqlite

# --- sqlite / better-sqlite3 (开发默认, 无需额外安装) ---
DB_SQLITE_PATH=./data/nestor.sqlite

# --- 服务器型数据库 (mysql/mariadb/postgres/cockroachdb/mssql/oracle) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestor
# schema 名 (postgres/cockroachdb/mssql 可用), 留空用驱动默认
DB_SCHEMA=
# mssql 是否启用 TLS 加密 (Azure SQL 通常需要 true; 本地自签证书可设 false)
DB_MSSQL_ENCRYPT=true
# 是否打印 SQL 日志
DB_LOGGING=false
# 仅开发期可开: 自动同步表结构 (生产请用 migration, 关掉它)
DB_SYNCHRONIZE=false
# 启动时是否自动执行 migration。内置迁移仅针对 sqlite;
# 切换到 mysql/postgres 时请先重新生成迁移, 必要时设为 false 关闭自动执行
DB_MIGRATIONS_RUN=true

# ============ Redis (缓存 / 限流 / 会话, 可选) ============
# 关闭时整个 Redis 能力降级为空操作, 不影响应用启动
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 所有 key 自动加的前缀, 便于多环境/多项目共用一个实例
REDIS_KEY_PREFIX=nestor:

# ============ MongoDB (文档数据层, 可选) ============
# 关闭时不建立连接; 与关系型数据库并存, 适合存日志/事件等文档数据
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017/nestor

# ============ 鉴权 (P2 使用) ============
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ============ 第三方登录 / OAuth (全部可选, 各家独立开关) ============
# 每家未配置 (ENABLED=false 或缺 client id/secret) 时不启用, 不影响应用启动。
# 成功登录后的统一处理: 若设置 OAUTH_SUCCESS_REDIRECT, 回调以 302 跳转到该地址,
# 并把 access_token/refresh_token/token_type 放在 URL hash (#) 中; 否则直接返回 JSON。
OAUTH_SUCCESS_REDIRECT=

# --- Google (https://console.cloud.google.com/apis/credentials) ---
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# --- GitHub (https://github.com/settings/developers -> OAuth Apps) ---
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/oauth/github/callback

# --- 微信开放平台 网站应用 (https://open.weixin.qq.com, scope=snsapi_login) ---
OAUTH_WECHAT_ENABLED=false
OAUTH_WECHAT_APP_ID=
OAUTH_WECHAT_APP_SECRET=
OAUTH_WECHAT_REDIRECT_URI=http://localhost:3000/api/auth/oauth/wechat/callback

# --- Apple (https://developer.apple.com -> Identifiers -> Services ID) ---
# client_secret 由 .p8 私钥 (ES256) 动态签出, 需填 Team ID / Key ID / Services ID / 私钥。
# 私钥可把 .p8 内容里的换行用 \n 转义后写成一行。
# 注意: Apple 回调使用 POST form_post, redirect_uri 必须是 https。
OAUTH_APPLE_ENABLED=false
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=
OAUTH_APPLE_REDIRECT_URI=https://your-domain/api/auth/oauth/apple/callback

# ============ 接口限流 (@nestjs/throttler, 全局) ============
# 关闭时不做限流; ttl 为时间窗口(毫秒), limit 为窗口内最大请求数。
# 登录/注册/验证码接口另有更严格的独立限流(见代码 @Throttle)。
THROTTLE_ENABLED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ============ 登录安全 (图形验证码 + 失败锁定) ============
# 验证码: 启用后, 登录失败累计达到阈值时要求图形验证码; ALWAYS=true 则每次登录都要。
SECURITY_CAPTCHA_ENABLED=true
SECURITY_CAPTCHA_ALWAYS=false
# 失败锁定: 失败达 CAPTCHA_AFTER 次后要验证码; 达 MAX_FAILURES 次后在 DURATION_SEC 秒内锁定。
# 计数与锁定优先用 Redis(REDIS_ENABLED=true), 未启用时退化为单实例内存。
SECURITY_LOCKOUT_CAPTCHA_AFTER=3
SECURITY_LOCKOUT_MAX_FAILURES=10
SECURITY_LOCKOUT_DURATION_SEC=900

# ============ 文件上传 / 存储 ============
# 存储驱动: local(本地磁盘, 默认) / s3(S3 兼容) / oss(阿里云 OSS)
STORAGE_DRIVER=local
# 单文件大小上限 (字节, 默认 10MB)
STORAGE_MAX_FILE_SIZE=10485760
# 允许的 MIME 类型, 逗号分隔; 留空表示不限制 (示例: image/png,image/jpeg,application/pdf)
STORAGE_ALLOWED_MIME_TYPES=
# -- local 驱动 --
# 落盘目录
STORAGE_LOCAL_DIR=./data/uploads
# 对外访问前缀; 本地文件经 GET {prefix}/:id/raw 回源, 默认 /api/files
STORAGE_LOCAL_PUBLIC_BASE_URL=/api/files
# -- s3 驱动 (AWS S3 / MinIO / R2 等) --
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# 自定义/CDN 访问域名; 留空按 endpoint/region 推导
STORAGE_S3_PUBLIC_BASE_URL=
# MinIO 等需 path-style 寻址
STORAGE_S3_FORCE_PATH_STYLE=false
# -- oss 驱动 (阿里云) --
STORAGE_OSS_REGION=oss-cn-hangzhou
STORAGE_OSS_BUCKET=
STORAGE_OSS_ACCESS_KEY_ID=
STORAGE_OSS_ACCESS_KEY_SECRET=
STORAGE_OSS_ENDPOINT=
STORAGE_OSS_PUBLIC_BASE_URL=

# ============ 通知 (邮件 / 短信 / 群机器人) ============
# 渠道: console(打到日志, 默认, 无需外部服务) / webhook(POST JSON 到下方地址)
NOTIFICATION_DRIVER=console
# -- webhook 驱动 (可对接飞书 / Slack / 企业微信机器人 / 自建网关) --
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_METHOD=POST
# 附加请求头, JSON 字符串, 例 {"Authorization":"Bearer xxx"}
NOTIFICATION_WEBHOOK_HEADERS=
NOTIFICATION_WEBHOOK_TIMEOUT_MS=10000

# ============ 工作流 ============
# 凭证加密密钥 (AES-256-GCM); 留空则回退用 JWT_ACCESS_SECRET
CREDENTIAL_ENCRYPTION_KEY=

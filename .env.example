# ============ 应用 ============
NODE_ENV=development
APP_PORT=3000
APP_PREFIX=api
# Swagger 文档开关
SWAGGER_ENABLED=true
# 允许的跨域来源 (逗号分隔), 留空则放行所有来源 (仅适合开发期)
# 例: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ============ 数据库（多数据库可切换） ============
# 支持: sqlite | mysql | postgres
DB_TYPE=sqlite

# --- sqlite (开发默认, 无需额外安装) ---
DB_SQLITE_PATH=./data/nestor.sqlite

# --- mysql / postgres (生产) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestor
# 是否打印 SQL 日志
DB_LOGGING=false
# 仅开发期可开: 自动同步表结构 (生产请用 migration, 关掉它)
DB_SYNCHRONIZE=false
# 启动时是否自动执行 migration。内置迁移仅针对 sqlite;
# 切换到 mysql/postgres 时请先重新生成迁移, 必要时设为 false 关闭自动执行
DB_MIGRATIONS_RUN=true

# ============ 鉴权 (P2 使用) ============
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

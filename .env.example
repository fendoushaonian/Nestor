# ============ 应用 ============
NODE_ENV=development
APP_PORT=3000
APP_PREFIX=api
# Swagger 文档开关
SWAGGER_ENABLED=true
# 允许的跨域来源 (逗号分隔), 留空则放行所有来源 (仅适合开发期)
# 例: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ============ 数据库（多数据库可切换） ============
# 支持: sqlite | better-sqlite3 | mysql | mariadb | postgres | cockroachdb | mssql | oracle
# 切换后只需重启, 业务代码不用改。各库需安装对应驱动 (按需, 见下方):
#   mysql / mariadb  -> pnpm --filter @nestor/api add mysql2
#   postgres / cockroachdb -> pnpm --filter @nestor/api add pg
#   mssql (SQL Server) -> pnpm --filter @nestor/api add mssql
#   oracle           -> pnpm --filter @nestor/api add oracledb
#   better-sqlite3   -> pnpm --filter @nestor/api add better-sqlite3
#   sqlite           -> 已内置, 无需安装
DB_TYPE=sqlite

# --- sqlite / better-sqlite3 (开发默认, 无需额外安装) ---
DB_SQLITE_PATH=./data/nestor.sqlite

# --- 服务器型数据库 (mysql/mariadb/postgres/cockroachdb/mssql/oracle) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestor
# schema 名 (postgres/cockroachdb/mssql 可用), 留空用驱动默认
DB_SCHEMA=
# mssql 是否启用 TLS 加密 (Azure SQL 通常需要 true; 本地自签证书可设 false)
DB_MSSQL_ENCRYPT=true
# 是否打印 SQL 日志
DB_LOGGING=false
# 仅开发期可开: 自动同步表结构 (生产请用 migration, 关掉它)
DB_SYNCHRONIZE=false
# 启动时是否自动执行 migration。内置迁移仅针对 sqlite;
# 切换到 mysql/postgres 时请先重新生成迁移, 必要时设为 false 关闭自动执行
DB_MIGRATIONS_RUN=true

# ============ 鉴权 (P2 使用) ============
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
